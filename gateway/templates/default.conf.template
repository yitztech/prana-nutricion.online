# Gateway de producción detrás del proxy de Coolify (Traefik).
#
# Traefik termina TLS y redirige http → https; este nginx escucha en HTTP (80) y reparte por dominio:
# - el del editor (ADMIN_URL, p. ej. admin.prana-nutricion.online): el panel y su API (/api/ → `app`);
# - cualquier otro, el sitio público (`web`), que solo expone /api/health de la API.
# Las variables ${...} las sustituye el entrypoint de nginx al arrancar; el server_name del editor
# lo genera 17-admin.sh a partir de ADMIN_URL.
server_tokens off;

# Docker cambia la IP de un contenedor cada vez que lo recrea. Con `resolve` nginx
# vuelve a consultar el DNS interno de Docker y sigue la IP nueva sin reiniciarse.
resolver 127.0.0.11 valid=10s ipv6=off;
upstream web_upstream { zone web_upstream 64k; server web:80 resolve; keepalive 16; }
upstream app_upstream { zone app_upstream 64k; server app:3000 resolve; keepalive 8; }

# ── IP real del cliente ─────────────────────────────────────────────
# Solo se confía en X-Forwarded-For si llega de la red donde está Traefik
# (TRUSTED_PROXY_CIDR). Sin esto todo el mundo parecería tener la IP de Traefik.
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Protocolo original: Traefik ya terminó TLS, aquí $scheme siempre es "http"
map $http_x_forwarded_proto $forwarded_proto { default $scheme; https https; }

# Identificador de cada petición en el log (nginx.conf): el que se pasa a los servicios
map "" $log_request_id { default $request_id; }

# ── Sitio público ───────────────────────────────────────────────────
server {
    listen 80 default_server;
    server_name _;

    include /tmp/nginx/snippets/platform-routes.conf;

    # Salud del backend para Uptime Kuma (§20); el resto de la API solo existe en el dominio del editor.
    location = /api/health {
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/api-headers.conf;
        proxy_read_timeout 5s;
        proxy_pass http://app_upstream;
    }
    location /api/ {
        include /etc/nginx/snippets/api-headers.conf;
        add_header Cache-Control "no-store" always;
        default_type application/problem+json;
        return 404 '{"type":"about:blank","title":"No encontrado","status":404,"code":"not_found","detail":"No existe o no está disponible."}';
    }

    # El editor vive en su propio dominio: aquí /admin es una página que no existe (el 404 del sitio).
    location ^~ /admin {
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/security-headers.conf;
        rewrite ^ /.no-existe break;
        proxy_pass http://web_upstream;
    }

    location / {
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/security-headers.conf;
        include /tmp/nginx/snippets/analytics*.conf;
        proxy_pass http://web_upstream;
    }
}

# ── Editor del sitio (ADMIN_URL) ────────────────────────────────────
# Sin analítica, fuera de los buscadores y con su propia CSP (admin-headers.conf). La cookie de sesión
# es `__Host-` y sin Domain: solo este host la recibe, nunca el sitio público.
server {
    listen 80;
    include /tmp/nginx/snippets/admin-host.conf;

    include /tmp/nginx/snippets/platform-routes.conf;

    location = /robots.txt {
        include /etc/nginx/snippets/admin-headers.conf;
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # API del editor. Cuerpo JSON de 1 MB como máximo (§23); la subida de imágenes, el suyo.
    location /api/ {
        client_max_body_size 1m;
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/api-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_read_timeout 60s;
        proxy_pass http://app_upstream;
    }
    location = /api/admin/uploads {
        # 8 MB de imagen más la envoltura multipart (shared/limits.ts, promotionImage.maxBytes)
        client_max_body_size 9m;
        proxy_request_buffering on;
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/api-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_read_timeout 60s;
        proxy_pass http://app_upstream;
    }

    # Recursos del build (JS y CSS con huella, tema, icono) e imágenes, los mismos que usa el sitio
    location ~ ^/(assets|img|uploads)/ {
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/admin-headers.conf;
        proxy_pass http://web_upstream;
    }
    location ~ ^/(theme\.js|favicon-prana\.png)$ {
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/admin-headers.conf;
        proxy_pass http://web_upstream;
    }

    # El panel es una sola página: cualquier otra ruta (/, /restablecer…) sirve /admin/ de `web`.
    location / {
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/admin-headers.conf;
        proxy_pass http://web_upstream/admin/;
    }
}
