# Gateway de producción detrás del proxy de Coolify (Traefik).
#
# Traefik termina TLS y redirige http → https; este nginx escucha en HTTP (80) y
# reparte por ruta: /api/ al servicio `app` (Node) y el resto a `web` (nginx con el sitio generado).
# Las variables ${...} las sustituye el entrypoint de nginx al arrancar.
server_tokens off;

# Docker cambia la IP de un contenedor cada vez que lo recrea. Con `resolve` nginx
# vuelve a consultar el DNS interno de Docker y sigue la IP nueva sin reiniciarse.
resolver 127.0.0.11 valid=10s ipv6=off;
upstream web_upstream { zone web_upstream 64k; server web:80 resolve; keepalive 16; }
upstream app_upstream { zone app_upstream 64k; server app:3000 resolve; keepalive 8; }

# ── IP real del cliente ─────────────────────────────────────────────
# Solo se confía en X-Forwarded-For si llega de la red donde está Traefik
# (TRUSTED_PROXY_CIDR). Sin esto todo el mundo parecería tener la IP de Traefik.
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Protocolo original: Traefik ya terminó TLS, aquí $scheme siempre es "http"
map $http_x_forwarded_proto $forwarded_proto { default $scheme; https https; }

# Identificador de cada petición en el log (nginx.conf): el que se pasa a los servicios
map "" $log_request_id { default $request_id; }

server {
    listen 80;
    server_name _;

    location = /healthz {
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # Commit desplegado: el workflow lo consulta para saber que la versión nueva ya sirve
    location = /version.json {
        add_header Content-Type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"revision":"${RELEASE_SHA}"}';
    }

    # API del editor. Cuerpo JSON de 1 MB como máximo (§23); la subida de imágenes, el suyo.
    location /api/ {
        client_max_body_size 1m;
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/api-headers.conf;
        proxy_read_timeout 60s;
        proxy_pass http://app_upstream;
    }
    location = /api/admin/uploads {
        # 8 MB de imagen más la envoltura multipart (shared/limits.ts, promotionImage.maxBytes)
        client_max_body_size 9m;
        proxy_request_buffering on;
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/api-headers.conf;
        proxy_read_timeout 60s;
        proxy_pass http://app_upstream;
    }

    # Editor del sitio: sin analítica; la vista previa de una imagen elegida usa blob:
    location /admin {
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/admin-headers.conf;
        proxy_pass http://web_upstream;
    }

    location / {
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/security-headers.conf;
        include /tmp/nginx/snippets/analytics*.conf;
        proxy_pass http://web_upstream;
    }
}
