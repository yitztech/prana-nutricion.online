{
  "name": "prana-nutricion.online",
  "private": true,
  "description": "Web de Prana & Nutrición (prana-nutricion.online)",
  "type": "module",
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "build": "tailwindcss -i web/src/styles.css -o web/public/assets/styles.css --minify",
    "dev": "tailwindcss -i web/src/styles.css -o web/public/assets/styles.css --watch",
    "test": "node scripts/test-all.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "e2e": "bddgen -c tests/e2e/playwright.config.js && playwright test -c tests/e2e/playwright.config.js",
    "e2e:headed": "npm run e2e -- --headed",
    "e2e:ui": "bddgen -c tests/e2e/playwright.config.js && playwright test -c tests/e2e/playwright.config.js --ui",
    "e2e:ver": "E2E_SLOWMO=${E2E_SLOWMO:-500} E2E_TECLADO=${E2E_TECLADO:-90} E2E_PAUSA=${E2E_PAUSA:-2000} npm run e2e -- --headed --workers=1 --project=chromium",
    "e2e:summary": "node tests/e2e/scripts/summary.mjs",
    "e2e:report": "playwright show-report tests/e2e/results/report",
    "check:audit": "node scripts/check-audit.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "playwright-bdd": "9.2.1",
    "tailwindcss": "4.3.3"
  }
}
