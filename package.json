{
  "name": "prana-nutricion.online",
  "private": true,
  "description": "Praná: Nutrición y Bienestar (prana-nutricion.online): sitio estático generado y panel de edición",
  "type": "module",
  "engines": {
    "node": "24.22.0"
  },
  "imports": {
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "build": "vite build -c web/vite.config.ts && vite build -c web/vite.config.ts --ssr src/entry-server.tsx",
    "dev": "vite -c web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json && tsc -p app/tsconfig.json",
    "generar": "node app/src/cli.ts generar",
    "admin:crear": "node app/src/cli.ts admin:crear",
    "images": "sh web/scripts/optimize-images.sh",
    "test": "node scripts/test-all.mjs",
    "test:unit": "node scripts/check-test-only.mjs && node --test 'tests/unit/*.test.mjs' 'web/src/**/*.test.ts' 'shared/**/*.test.ts' 'app/src/**/*.test.ts'",
    "test:db": "node --test --test-concurrency=1 'tests/db/*.test.ts'",
    "test:api": "node --test 'tests/api/flujos/*.test.ts'",
    "test:endpoints": "node --test 'tests/api/endpoints/*.test.ts'",
    "test:security": "node --test 'tests/api/seguridad/*.test.ts'",
    "e2e": "bddgen -c tests/e2e/playwright.config.js && playwright test -c tests/e2e/playwright.config.js",
    "e2e:headed": "npm run e2e -- --headed",
    "e2e:ui": "bddgen -c tests/e2e/playwright.config.js && playwright test -c tests/e2e/playwright.config.js --ui",
    "e2e:ver": "E2E_SLOWMO=${E2E_SLOWMO:-500} E2E_TECLADO=${E2E_TECLADO:-90} E2E_PAUSA=${E2E_PAUSA:-2000} npm run e2e -- --headed --workers=1 --project=chromium",
    "e2e:summary": "node tests/e2e/scripts/summary.mjs",
    "e2e:report": "playwright show-report tests/e2e/results/report",
    "check:audit": "node scripts/check-audit.mjs",
    "check:migraciones": "squawk app/migrations/*.sql"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.6",
    "argon2": "0.45.1",
    "fastify": "5.12.7",
    "file-type": "22.3.0",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/parisienne": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/extension-link": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.65.0",
    "playwright-bdd": "9.2.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "squawk-cli": "2.70.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
